[Unit]
Description=OpenVibe.Community — The people of OpenVibe (pastes; forums and submissions to follow)
# Live (openvibe-live) and Network (openvibe-network) should be up first, but
# Community degrades gracefully if they aren't (paste pages answer 502, sign-in retries).
After=network.target
Wants=openvibe-live.service openvibe-network.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/openvibe.community
EnvironmentFile=/etc/openvibe/community.env
Environment=NODE_ENV=production
Environment=PORT=4200
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env node /opt/openvibe.community/server/index.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Community's own database (used once PASTES_AUTHORITY=community; untouched before that).
# The code tree stays read-only; the database lives in /var/lib/openvibe-community.
StateDirectory=openvibe-community
Environment=COMMUNITY_DB_PATH=/var/lib/openvibe-community/community.db

[Install]
WantedBy=multi-user.target
