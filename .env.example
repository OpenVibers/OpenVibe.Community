# ═══════════════════════════════════════════════════════════════
# openvibe.community — Environment Configuration
# Copy to .env and fill in values.
# In production this lives at /etc/openvibe/community.env (0600).
# ═══════════════════════════════════════════════════════════════

# Server
PORT=4200
HOST=127.0.0.1
NODE_ENV=development
BASE_URL=http://localhost:4200
# Proxy hops that set X-Forwarded-For (Cloudflare → nginx → Node = 2)
TRUST_PROXY=2

# Identity provider — OpenVibe.Network (OAuth2 authorization server + JWKS)
OV_NETWORK_URL=https://openvibe.network
OV_NETWORK_INTERNAL_URL=http://127.0.0.1:4000

# OAuth2 client credentials (client `community` registered in the Network DB,
# redirect https://openvibe.community/auth/callback)
OV_OAUTH_CLIENT_ID=community
OV_OAUTH_CLIENT_SECRET=change-me-to-the-registered-community-secret
# Production: https://openvibe.community/auth/callback
OV_OAUTH_REDIRECT_URI=http://localhost:4200/auth/callback

# Cookies — production default is Secure; set false for plain-http local dev
#COOKIE_SECURE=false

# OpenVibe.Live — every /api/pastes/* call is proxied here (internal URL);
# Live maps the visitor's Network JWT onto its own account ids before it talks to Media.
OV_LIVE_INTERNAL_URL=http://127.0.0.1:3000
OV_LIVE_URL=https://openvibe.live

# OpenVibe.Media — public host for raw paste text and screenshots
OV_MEDIA_URL=https://openvibe.media
# Media's internal address: new screenshot uploads (community authority) go to its file store
# with a service token (the OAuth client needs media.object.upload for audience openvibe.media).
OV_MEDIA_INTERNAL_URL=http://127.0.0.1:4100

# Who owns pastes:
#   live       (default) /api/pastes/* proxies to OpenVibe.Live, pages read through Live
#   community  this site's own database is the authority (native API, pages, raw text)
# With 'community' the OAuth client above also needs identity.subject.resolve (author names).
PASTES_AUTHORITY=live
# SQLite database (production unit: /var/lib/openvibe-community/community.db). Comments, the
# forum, Pulse and the relay's bookkeeping live here in every mode; pastes too with 'community'.
COMMUNITY_DB_PATH=./data/community.db
# Optional salt for hashed visitor ids in view counting (default: derived from the client secret)
#VIEW_HASH_SECRET=

# Browser origins allowed to call /api/v1/comments and /api/v1/pulse with a Bearer Network JWT
#API_CORS_ORIGINS=https://openvibe.live,https://openvibe.media,https://openvibe.network,https://openvibe.tools,https://openvibe.games

# Discord relay (outbound: new threads in mapped spaces → a Discord webhook). Off by default.
# Mappings (POST /api/v1/relay/mappings, staff) name an ENVIRONMENT VARIABLE that holds the
# webhook URL — the URL itself never goes into the database.
#DISCORD_RELAY_ENABLED=true
#DISCORD_WEBHOOK_FEEDBACK=https://discord.com/api/webhooks/<id>/<token>
# Variables a mapping may name: DISCORD_WEBHOOK_* unless this lists the exact names.
#DISCORD_RELAY_WEBHOOK_VARS=DISCORD_WEBHOOK_FEEDBACK,DISCORD_WEBHOOK_GENERAL
#DISCORD_RELAY_POLL_MS=30000
#DISCORD_RELAY_BACKOFF_MS=30000
#DISCORD_RELAY_MAX_ATTEMPTS=6
