# ═══════════════════════════════════════════════════════════════
# openvibe.community — Environment Configuration
# Copy to .env and fill in values.
# In production this lives at /etc/openvibe/community.env (0600).
# ═══════════════════════════════════════════════════════════════

# Server
PORT=4200
HOST=127.0.0.1
NODE_ENV=development
BASE_URL=http://localhost:4200
# Proxy hops that set X-Forwarded-For (Cloudflare → nginx → Node = 2)
TRUST_PROXY=2

# Identity provider — OpenVibe.Network (OAuth2 authorization server + JWKS)
OV_NETWORK_URL=https://openvibe.network
OV_NETWORK_INTERNAL_URL=http://127.0.0.1:4000

# OAuth2 client credentials (client `community` registered in the Network DB,
# redirect https://openvibe.community/auth/callback)
OV_OAUTH_CLIENT_ID=community
OV_OAUTH_CLIENT_SECRET=change-me-to-the-registered-community-secret
# Production: https://openvibe.community/auth/callback
OV_OAUTH_REDIRECT_URI=http://localhost:4200/auth/callback

# Cookies — production default is Secure; set false for plain-http local dev
#COOKIE_SECURE=false

# OpenVibe.Live — every /api/pastes/* call is proxied here (internal URL);
# Live maps the visitor's Network JWT onto its own account ids before it talks to Media.
OV_LIVE_INTERNAL_URL=http://127.0.0.1:3000
OV_LIVE_URL=https://openvibe.live

# OpenVibe.Media — public host for raw paste text and screenshots
OV_MEDIA_URL=https://openvibe.media
