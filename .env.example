# ═══════════════════════════════════════════════════════════════
# openvibe.community — Environment Configuration
# Copy to .env and fill in values.
# In production this lives at /etc/openvibe/community.env (0600).
# ═══════════════════════════════════════════════════════════════

# Server
PORT=4200
HOST=127.0.0.1
NODE_ENV=development
BASE_URL=http://localhost:4200
# Proxy hops that set X-Forwarded-For (Cloudflare → nginx → Node = 2)
TRUST_PROXY=2

# Identity provider — OpenVibe.Network (OAuth2 authorization server + JWKS)
OV_NETWORK_URL=https://openvibe.network
OV_NETWORK_INTERNAL_URL=http://127.0.0.1:4000

# OAuth2 client credentials (client `community` registered in the Network DB,
# redirect https://openvibe.community/auth/callback)
OV_OAUTH_CLIENT_ID=community
OV_OAUTH_CLIENT_SECRET=change-me-to-the-registered-community-secret
# Production: https://openvibe.community/auth/callback
OV_OAUTH_REDIRECT_URI=http://localhost:4200/auth/callback

# Cookies — production default is Secure; set false for plain-http local dev
#COOKIE_SECURE=false

# OpenVibe.Live — author links, avatars and legal pages (no paste traffic).

OV_LIVE_URL=https://openvibe.live

# OpenVibe.Media — public host for screenshot bytes
OV_MEDIA_URL=https://openvibe.media
# Media's internal address: new screenshot uploads go to its file store
# with a service token (the OAuth client needs media.object.upload for audience openvibe.media).
OV_MEDIA_INTERNAL_URL=http://127.0.0.1:4100

# Pastes are Community's own (native API, pages, raw text); the OAuth client above also needs
# identity.subject.resolve (author names).

# PostgreSQL (ADR-035), written by OpenVibe.Host roles/data/add-service.sh community: the runtime role through
# PgBouncer, the owner on a direct connection (migrations), and Valkey (shared limit counters). Pastes, comments,
# Pulse and submissions live there. Without
# DATABASE_URL, development uses an embedded PGlite database in data/pglite.
DATABASE_URL=
DATABASE_DIRECT_URL=
VALKEY_URL=
VALKEY_PREFIX=
# Optional salt for hashed visitor ids in view counting (default: derived from the client secret)
#VIEW_HASH_SECRET=

# Per-actor limits (server/actor-limits.js): reads one caller (a person, a service or app acting as
# itself, else an address) may make to one API per minute and per hour; past them 429 rate_limited
# with Retry-After. Writes have their own numbers (README). The per-address /api/ limit stays.
#COMMUNITY_LIMITS_MINUTE=120
#COMMUNITY_LIMITS_HOUR=3000

# Browser origins allowed to call /api/v1/comments and /api/v1/pulse with a Bearer Network JWT
#API_CORS_ORIGINS=https://openvibe.live,https://openvibe.media,https://openvibe.network,https://openvibe.tools,https://openvibe.games
